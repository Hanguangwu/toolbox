---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import {
  tools,
  categoryCounts,
  tagCounts,
  platformCounts,
  searchBlob,
  categoryName,
} from '../lib/tools';

const topTags = tagCounts.slice(0, 10);
// 筛选行只放已有 2 条以上的标签，长尾靠搜索与标签页承接
const facetTags = tagCounts.filter((t) => t.count >= 2);
---

<Base
  title="工具岛 · 工具集"
  description={`收录 ${tools.length} 个实用工具，卡片式浏览，支持中文与英文搜索，按分类与标签筛选。`}
>
  <header class="hero">
    <div class="shell hero__inner">
      <span class="hero__badge">🏝 已收录 {tools.length} 个工具 · {categoryCounts.length} 个分类</span>
      <h1>工具岛</h1>
      <p class="hero__sub">
        按名称、标签或用途搜索。每个条目都有分类与标签，由 AI Agent 维护，来源可查。
      </p>

      <form class="search" role="search" onsubmit="return false">
        <span class="search__icon" aria-hidden="true">🔍</span>
        <input
          id="q"
          type="search"
          placeholder="搜索工具名、标签或用途，例如「压缩」"
          autocomplete="off"
          spellcheck="false"
          aria-label="搜索工具"
        />
        <kbd class="kbd" aria-hidden="true">/</kbd>
      </form>

      <div class="hero__tags">
        {
          topTags.map((t) => (
            <button type="button" class="tagpill" data-q={t.name}>
              #{t.name}
              <span class="tagpill__count">{t.count}</span>
            </button>
          ))
        }
      </div>
    </div>
  </header>

  <nav class="filters" aria-label="筛选工具">
    <div class="shell filters__row">
      <span class="filters__label">分类</span>
      <button
        type="button"
        class="chipbtn"
        data-facet="category"
        data-value="all"
        aria-pressed="true"
      >
        全部<span class="chipbtn__count">{tools.length}</span>
      </button>
      {
        categoryCounts.map((c) => (
          <button type="button" class="chipbtn" data-facet="category" data-value={c.id} aria-pressed="false">
            {c.name}
            <span class="chipbtn__count">{c.count}</span>
          </button>
        ))
      }
    </div>

    <div class="shell filters__row filters__row--sub">
      <span class="filters__label">标签</span>
      {
        facetTags.map((t) => (
          <button type="button" class="chipbtn chipbtn--sub" data-facet="tag" data-value={t.id} aria-pressed="false">
            #{t.name}
            <span class="chipbtn__count">{t.count}</span>
          </button>
        ))
      }
      <span class="filters__sep" aria-hidden="true"></span>
      <span class="filters__label">平台</span>
      {
        platformCounts.map((p) => (
          <button type="button" class="chipbtn chipbtn--sub" data-facet="platform" data-value={p.id} aria-pressed="false">
            {p.name}
            <span class="chipbtn__count">{p.count}</span>
          </button>
        ))
      }
    </div>
  </nav>

  <main class="shell">
    <div class="resultbar">
      <p class="resultbar__count" aria-live="polite">
        找到 <strong id="result-num">{tools.length}</strong> 个工具
      </p>
      <button type="button" class="resultbar__clear" id="clear" hidden>清空筛选</button>
    </div>

    <ul class="grid" id="grid">
      {
        tools.map((t) => (
          <li
            class="grid__item"
            data-id={t.id}
            data-cat={t.category}
            data-tags={t.tags.join(',')}
            data-platforms={(t.platforms ?? []).join(',')}
            data-s={searchBlob(t)}
            data-name={t.name}
            data-desc={t.description}
          >
            <Card tool={t} />
          </li>
        ))
      }
    </ul>

    <div class="loadmore" id="loadmore" hidden>
      <button type="button" class="btn" id="loadmore-btn">
        加载更多<span class="chipbtn__count">还有 <span id="loadmore-n">0</span> 条</span>
      </button>
    </div>

    <div class="empty" id="empty" hidden>
      <span class="empty__emoji" aria-hidden="true">🏝</span>
      <h2>这座岛上还没有这个工具</h2>
      <p>换个关键词，或者清空筛选看看全部 {tools.length} 个条目。</p>
      <p>
        <button type="button" class="btn" id="clear-empty">清空筛选</button>
      </p>
    </div>
  </main>

  <footer class="footer">
    <div class="shell footer__inner">
      <span>工具岛 · 内容由 AI Agent 维护，PR 可审</span>
      <span>共 {tools.length} 条 · 最近更新 2026-11</span>
    </div>
  </footer>

  <script>
    import '../scripts/island.ts';
  </script>
</Base>
