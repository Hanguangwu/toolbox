{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://toolbox.local/schema/tool.schema.json",
  "title": "Tool entry",
  "description": "单个工具条目的唯一契约。字段语义与维护规则见 AGENTS.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "url",
    "category",
    "tags",
    "status",
    "added_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "稳定主键，同时是文件名与 slug；发布后不可变"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "官方名称原文，保留英文大小写"
    },
    "description": {
      "type": "string",
      "minLength": 24,
      "maxLength": 120,
      "description": "一句话：做什么 + 给谁 + 关键差异。禁止营销词。"
    },
    "how": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300,
      "description": "实现方式：怎么做到的，一句话技术路径（语言/架构/机制/协议）。非必填。"
    },
    "url": {
      "type": "string",
      "pattern": "^https://",
      "description": "用户点击卡片后到达的地址"
    },
    "logo": {
      "type": "string",
      "pattern": "^/logos/",
      "description": "构建期本地化后的站内路径，禁止外链"
    },
    "logo_source": {
      "type": "string",
      "pattern": "^https://",
      "description": "LOGO 原始来源，供构建脚本下载"
    },
    "category": {
      "type": "string",
      "description": "必须命中 data/taxonomy.yaml 的 categories"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "description": "1-5 个，必须命中 taxonomy 的 canonical 标签"
    },
    "aliases": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "description": "英文名/曾用名/中文简称，用于搜索召回；不含拼音"
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["web", "windows", "macos", "linux", "android", "ios", "cli", "docker"]
      }
    },
    "open_source": { "type": "boolean" },
    "featured": { "type": "boolean" },
    "pricing": {
      "enum": ["free", "freemium", "paid", "open-source"]
    },
    "status": {
      "enum": ["draft", "published", "deprecated"]
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "GitHub 仓库全名，去重主键之一"
    },
    "stars": { "type": "integer", "minimum": 0 },
    "license": { "type": "string", "maxLength": 40 },
    "source": {
      "type": "string",
      "pattern": "^https://",
      "description": "描述的事实来源，反幻觉关键字段"
    },
    "added_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
